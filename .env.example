# ============================================================
# SSR Airport AI — Environment Variables
#
# REPLIT SETUP:
#   Add these in: Replit sidebar → Tools → Secrets
#   Do NOT commit a filled-in .env file — use Replit Secrets.
#
# LOCAL SETUP:
#   Copy this file:  cp .env.example .env
#   Then fill in values below.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME="SSR Airport AI"
APP_ENV=development           # development | staging | production

# Set these to your actual Replit URLs once the Repl is running:
# API_BASE_URL=https://ssr-airport-ai.YOUR_USERNAME.repl.co:8000
# FRONTEND_URL=https://ssr-airport-ai.YOUR_USERNAME.repl.co
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Database (required) ───────────────────────────────────────
# Recommended: Supabase (free tier works fine)
#   1. Create a project at https://supabase.com
#   2. Go to Settings → Database → Connection string (URI)
#   3. Paste it here
DATABASE_URL=postgresql://user:password@localhost:5432/ssr_ai

# ── Redis (optional) ─────────────────────────────────────────
# Leave blank to run without Redis (caching disabled).
# Free option: https://upstash.com
# REDIS_URL=rediss://default:password@host:6380

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx

# ── Anthropic — Claude AI (required for chat) ────────────────
ANTHROPIC_API_KEY=sk-ant-xxx

# ── Bland.ai — Voice AI ──────────────────────────────────────
BLAND_AI_API_KEY=xxx

# ── Twilio — Phone & WhatsApp ────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SSR_NUMBER=+230603800
TWILIO_WHATSAPP_NUMBER=+14155238886
SSR_HUMAN_AGENTS_NUMBER=+230xxxxxxxx

# ── SSR Systems Integration ───────────────────────────────────
FIDS_API_URL=https://fids.ssr-airport.mu/api
FIDS_API_KEY=xxx
BOOKING_SYSTEM_URL=https://booking.airmauritius.com/api
BOOKING_SYSTEM_API_KEY=xxx
CISCO_IPCC_WEBHOOK_URL=https://ipcc.ssr-airport.mu/webhook

# ── Monitoring (optional) ─────────────────────────────────────
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
LOGTAIL_TOKEN=xxx

# ── Feature Flags ─────────────────────────────────────────────
VOICE_AI_ENABLED=true
WHATSAPP_ENABLED=true
EMAIL_AI_ENABLED=false

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Security ──────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-minimum-32-chars

# ── CORS (auto-configured for Replit; override if needed) ─────
# Comma-separated list of allowed frontend origins.
# Replit URLs are added automatically — only override if you need more.
# CORS_ORIGINS_RAW=https://your-custom-domain.com

# ── Frontend (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx
